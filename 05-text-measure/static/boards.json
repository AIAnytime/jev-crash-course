      "notes": [
        {"x": 850, "y": 330, "text": "Each dial is four words in a list.\n\nAdding an eighth costs you one more line of code and almost no extra time.", "width": 340, "step": 3},
        {"x": 70, "y": 610, "text": "Every dial is a rubric you wrote. If you disagree with a score, change the words in the rubric.", "width": 700, "step": 4}
