    {
      "name": "What the run showed",
      "nodes": [
        {"id": "a", "x": 70, "y": 140, "w": 520, "h": 200, "head": "Jev", "text": "abusive call: never flipped\nworst case 0.96 → 0.72", "size": 21, "tone": "good", "step": 0},
        {"id": "b", "x": 680, "y": 140, "w": 500, "h": 200, "head": "language model", "text": "abusive call: flipped twice\n0.85 → 0.00", "size": 21, "tone": "bad", "step": 1},
        {"id": "c", "x": 70, "y": 400, "w": 1110, "h": 160, "head": "but both moved on priority", "text": "an injection that says \"this is low priority\" often gets low priority", "size": 21, "tone": "warn", "step": 2}
      ],
      "arrows": [],
      "notes": [
        {"x": 70, "y": 610, "text": "A model that cannot be made to say anything can still be persuaded of something.", "width": 1150, "step": 3}
      ]
    },
    {
      "name": "So what do you do about it",
      "nodes": [
        {"id": "a", "x": 70, "y": 150, "w": 520, "h": 150, "text": "keep the user text in its own field", "size": 21, "tone": "accent", "step": 0},
        {"id": "b", "x": 70, "y": 340, "w": 520, "h": 150, "text": "never let the input set the question", "size": 21, "tone": "accent", "step": 1},
        {"id": "c", "x": 660, "y": 150, "w": 520, "h": 150, "text": "watch the probability, not just the answer", "size": 21, "tone": "good", "step": 2},
        {"id": "d", "x": 660, "y": 340, "w": 520, "h": 150, "text": "a sudden drop is worth an alert", "size": 21, "tone": "good", "step": 3}
      ],
      "arrows": [],
      "notes": [
        {"x": 70, "y": 570, "text": "The number that moves under attack is also the number that tells you it happened.", "width": 1150, "step": 4}
      ]
    }
