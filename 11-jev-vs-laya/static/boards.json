    {
      "name": "What 200 reviews showed",
      "nodes": [
        {"id": "a", "x": 60, "y": 120, "w": 550, "h": 150, "head": "how often right", "text": "0.805  vs  0.800", "size": 24, "tone": "muted", "step": 0},
        {"id": "b", "x": 670, "y": 120, "w": 550, "h": 150, "head": "one call", "text": "380ms  vs  230ms", "size": 24, "tone": "good", "step": 1},
