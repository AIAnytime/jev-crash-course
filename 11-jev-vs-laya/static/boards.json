    {
      "name": "So which one",
      "nodes": [
        {"id": "l1", "x": 60, "y": 130, "w": 540, "h": 120, "text": "the data cannot leave", "size": 22, "tone": "good", "step": 0},
        {"id": "l2", "x": 60, "y": 270, "w": 540, "h": 120, "text": "you need a tight, predictable tail", "size": 22, "tone": "good", "step": 1},
        {"id": "l3", "x": 60, "y": 410, "w": 540, "h": 120, "text": "it has to work offline", "size": 22, "tone": "good", "step": 2},
        {"id": "r1", "x": 680, "y": 130, "w": 540, "h": 120, "text": "you need bursts of throughput", "size": 22, "tone": "accent", "step": 3},
        {"id": "r2", "x": 680, "y": 270, "w": 540, "h": 120, "text": "nobody wants to run a GPU", "size": 22, "tone": "accent", "step": 4},
        {"id": "r3", "x": 680, "y": 410, "w": 540, "h": 120, "text": "you want someone else on call", "size": 22, "tone": "accent", "step": 5}
