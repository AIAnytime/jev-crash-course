        {"id": "d", "x": 670, "y": 310, "w": 550, "h": 150, "head": "the bill", "text": "half a cent  vs  nothing", "size": 22, "tone": "good", "step": 3},
        {"id": "e", "x": 60, "y": 500, "w": 1160, "h": 140, "head": "but they agreed on only half the topic calls", "text": "same score, different answers", "size": 22, "tone": "warn", "step": 4}
